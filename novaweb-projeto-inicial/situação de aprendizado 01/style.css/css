* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #0b0f19;
    color: #ffffff;
    line-height: 1.6;
}

header {
    background-color: #151c2c;
    border-bottom: 2px solid #00d2ff;
    padding: 1.5rem 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h1 {
    font-size: 2rem;
    color: #00d2ff;
    text-transform: uppercase;
}

nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
}

nav a {
    color: #94a3b8;
    text-decoration: none;
    font-weight: bold;
    font-size: 1.1rem;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    transition: all 0.3s;
}

nav a:hover, nav a.active {
    color: #00d2ff;
    background-color: rgba(0, 210, 255, 0.1);
}

main {
    max-width: 1300px;
    margin: 2rem auto;
    padding: 0 1.5rem;
}

/* BANNER PRINCIPAL COM FOTO DE DESTAQUE */
.hero {
    background: linear-gradient(rgba(11, 15, 25, 0.5), rgba(11, 15, 25, 0.8)), 
                url('https://images.unsplash.com/photo-1490578474895-699bc4e2cf59?q=80&w=1600&auto=format&fit=crop') center/cover no-repeat;
    height: 400px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin-bottom: 4rem;
    border: 1px solid #243048;
}

.hero h2 {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: #ffffff;
}

.subtitulo-secao {
    text-align: center;
    margin-bottom: 3rem;
}

.subtitulo-secao h2 {
    font-size: 2.2rem;
    color: #ffffff;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
}

.subtitulo-secao p {
    color: #94a3b8;
    font-size: 1.1rem;
}

.grid-produtos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
}

.card-produto {
    background-color: #151c2c;
    border: 1px solid #243048;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.card-produto:hover {
    border-color: #00d2ff;
}

.card-produto h3 {
    font-size: 1.6rem;
    color: #ffffff;
    margin-bottom: 1rem;
    text-transform: uppercase;
}

.card-produto img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 1rem;
}

.preco {
    font-size: 1.8rem;
    font-weight: bold;
    color: #00d2ff;
    margin-bottom: 1.2rem;
}

.btn {
    display: block;
    width: 100%;
    background-color: #00d2ff;
    color: #0b0f19;
    font-size: 1.1rem;
    font-weight: bold;
    padding: 0.9rem 0;
    border-radius: 6px;
    text-decoration: none;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    text-align: center;
}

.btn:hover {
    background-color: #009dff;
    color: #ffffff;
}

/* FORMULÁRIO E COMENTÁRIOS */
.form-contato {
    background-color: #151c2c;
    border: 2px solid #00d2ff;
    border-radius: 12px;
    padding: 3rem;
    max-width: 700px;
    margin: 0 auto 4rem auto;
}

.campo {
    margin-bottom: 1.8rem;
}

.campo label {
    color: #00d2ff;
    font-size: 1.1rem;
    font-weight: bold;
    display: block;
    margin-bottom: 0.6rem;
}

.campo input, .campo select, .campo textarea {
    background-color: #0b0f19;
    border: 1px solid #243048;
    color: #ffffff;
    padding: 1rem;
    border-radius: 6px;
    width: 100%;
    font-size: 1rem;
}

.campo input:focus, .campo select:focus, .campo textarea:focus {
    outline: none;
    border-color: #00d2ff;
}

.secao-comentarios {
    max-width: 800px;
    margin: 0 auto;
}

.cartao-comentario {
    background-color: #151c2c;
    border: 1px solid #243048;
    border-left: 4px solid #00d2ff;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
}

.autor-comentario {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
}

.autor-comentario h4 {
    color: #ffffff;
    font-size: 1.2rem;
}

.estrelas {
    color: #00d2ff;
}

.texto-comentario {
    color: #94a3b8;
}

footer {
    background-color: #151c2c;
    border-top: 1px solid #243048;
    text-align: center;
    padding: 2.5rem;
    margin-top: 5rem;
    color: #94a3b8;
}